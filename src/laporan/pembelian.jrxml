	<queryString language="SQL">
		<![CDATA[SELECT
     pembelian.`no_faktur` AS pembelian_no_faktur,
     pembelian.`tanggal_beli` AS pembelian_tanggal_beli,
     pembelian.`id_petugas` AS pembelian_id_petugas,
     pembelian.`total_bayar` AS pembelian_total_bayar,
     pembelian_detail.`id_detail` AS pembelian_detail_id_detail,
     pembelian_detail.`no_faktur` AS pembelian_detail_no_faktur,
     pembelian_detail.`id_buku` AS pembelian_detail_id_buku,
     pembelian_detail.`jumlah_beli` AS pembelian_detail_jumlah_beli,
     pembelian_detail.`harga_beli` AS pembelian_detail_harga_beli,
     pembelian_detail.`subtotal` AS pembelian_detail_subtotal,
     buku.`judul` AS buku_judul,
     buku.`id_buku` AS buku_id_buku,
     petugas.`id_petugas` AS petugas_id_petugas,
     petugas.`nama` AS petugas_nama
FROM
     `pembelian` pembelian INNER JOIN `pembelian_detail` pembelian_detail ON pembelian.`no_faktur` = pembelian_detail.`no_faktur`
     INNER JOIN `buku` buku ON pembelian_detail.`id_buku` = buku.`id_buku`
     INNER JOIN `petugas` petugas ON pembelian.`id_petugas` = petugas.`id_petugas`]]>
	</queryString>
