	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[SELECT
     pengembalian.`id_pengembalian` AS pengembalian_id_pengembalian,
     pengembalian.`id_peminjaman` AS pengembalian_id_peminjaman,
     pengembalian.`tanggal_dikembalikan` AS pengembalian_tanggal_dikembalikan,
     pengembalian.`denda` AS pengembalian_denda,
     peminjaman.`id_peminjaman` AS peminjaman_id_peminjaman,
     peminjaman.`tanggal_pinjam` AS peminjaman_tanggal_pinjam,
     peminjaman.`tanggal_kembali` AS peminjaman_tanggal_kembali,
     anggota.`id_anggota` AS anggota_id_anggota,
     anggota.`nama_lengkap` AS anggota_nama_lengkap,
     buku.`id_buku` AS buku_id_buku,
     buku.`judul` AS buku_judul
FROM
     `peminjaman` peminjaman 
     INNER JOIN `pengembalian` pengembalian ON peminjaman.`id_peminjaman` = pengembalian.`id_peminjaman`
     INNER JOIN `anggota` anggota ON peminjaman.`id_anggota` = anggota.`id_anggota`
     INNER JOIN `peminjaman_detail` peminjaman_detail ON peminjaman.`id_peminjaman` = peminjaman_detail.`id_peminjaman`
     INNER JOIN `buku` buku ON peminjaman_detail.`id_buku` = buku.`id_buku`]]>
	</queryString>
	<field name="pengembalian_id_pengembalian" class="java.lang.Integer"/>
	<field name="pengembalian_id_peminjaman" class="java.lang.Integer"/>
	<field name="pengembalian_tanggal_dikembalikan" class="java.sql.Date"/>
	<field name="pengembalian_denda" class="java.lang.Integer"/>
