	<queryString language="SQL">
		<![CDATA[SELECT
     buku_rusak_hilang.`id_kasus` AS buku_rusak_hilang_id_kasus,
     buku_rusak_hilang.`tanggal_lapor` AS buku_rusak_hilang_tanggal_lapor,
     buku_rusak_hilang.`id_buku` AS buku_rusak_hilang_id_buku,
     buku_rusak_hilang.`id_anggota` AS buku_rusak_hilang_id_anggota,
     buku_rusak_hilang.`id_petugas` AS buku_rusak_hilang_id_petugas,
     buku_rusak_hilang.`jenis_kondisi` AS buku_rusak_hilang_jenis_kondisi,
     buku_rusak_hilang.`jumlah` AS buku_rusak_hilang_jumlah,
     buku_rusak_hilang.`denda_ganti_rugi` AS buku_rusak_hilang_denda_ganti_rugi,
     buku_rusak_hilang.`status_solusi` AS buku_rusak_hilang_status_solusi,
     buku.`id_buku` AS buku_id_buku,
     buku.`judul` AS buku_judul,
     anggota.`id_anggota` AS anggota_id_anggota,
     anggota.`nama_lengkap` AS anggota_nama_lengkap
FROM
     `buku` buku INNER JOIN `buku_rusak_hilang` buku_rusak_hilang ON buku.`id_buku` = buku_rusak_hilang.`id_buku`
     INNER JOIN `anggota` anggota ON buku_rusak_hilang.`id_anggota` = anggota.`id_anggota`]]>
	</queryString>
