	<queryString language="SQL">
		<![CDATA[SELECT
     peminjaman.`id_peminjaman` AS peminjaman_id_peminjaman,
     peminjaman.`tanggal_pinjam` AS peminjaman_tanggal_pinjam,
     peminjaman.`tanggal_kembali` AS peminjaman_tanggal_kembali,
     peminjaman.`id_anggota` AS peminjaman_id_anggota,
     peminjaman.`id_petugas` AS peminjaman_id_petugas,
     peminjaman.`status` AS peminjaman_status,
     peminjaman_detail.`id_detail` AS peminjaman_detail_id_detail,
     peminjaman_detail.`id_peminjaman` AS peminjaman_detail_id_peminjaman,
     peminjaman_detail.`id_buku` AS peminjaman_detail_id_buku,
     buku.`id_buku` AS buku_id_buku,
     buku.`judul` AS buku_judul,
     anggota.`nama_lengkap` AS anggota_nama_lengkap,
     anggota.`id_anggota` AS anggota_id_anggota
FROM
     `peminjaman` peminjaman INNER JOIN `peminjaman_detail` peminjaman_detail ON peminjaman.`id_peminjaman` = peminjaman_detail.`id_peminjaman`
     INNER JOIN `buku` buku ON peminjaman_detail.`id_buku` = buku.`id_buku`
     INNER JOIN `anggota` anggota ON peminjaman.`id_anggota` = anggota.`id_anggota`]]>
	</queryString>
	<field name="peminjaman_id_peminjaman" class="java.lang.Integer"/>
	<field name="peminjaman_tanggal_pinjam" class="java.sql.Date"/>
	<field name="peminjaman_tanggal_kembali" class="java.sql.Date"/>
	<field name="peminjaman_id_anggota" class="java.lang.Integer"/>
	<field name="peminjaman_id_petugas" class="java.lang.Integer"/>
	<field name="peminjaman_status" class="java.lang.String"/>
	<field name="peminjaman_detail_id_detail" class="java.lang.Integer"/>
	<field name="peminjaman_detail_id_peminjaman" class="java.lang.Integer"/>
	<field name="peminjaman_detail_id_buku" class="java.lang.Integer"/>
	<field name="buku_id_buku" class="java.lang.Integer"/>
	<field name="buku_judul" class="java.lang.String"/>
	<field name="anggota_nama_lengkap" class="java.lang.String"/>
	<field name="anggota_id_anggota" class="java.lang.Integer"/>
